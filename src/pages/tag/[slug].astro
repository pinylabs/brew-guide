---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	decodeSlug,
} from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("tag", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}
---

<Base
	title={`Posts tagged "${term.label}"`}
	description={`Posts tagged ${term.label}`}
>
	<section class="page-head wrap">
		<p class="eyebrow">Tag</p>
		<h1 class="page-title">#<em class="text-primary-500">{term.label}</em></h1>
	</section>

	<div class="wrap">
		{
			posts.length === 0 ? (
				<p class="text-xl text-neutral-400">No posts with this tag yet.</p>
			) : (
				<ul class="cards">
					{posts.map((post) => (
						<li>
							<a class="group block" href={`/posts/${post.id}`}>
								{post.data.featured_image && (
									<div class="card-photo" {...post.edit.featured_image}><Image class="photo-lean" image={post.data.featured_image} /></div>
								)}
								<h2 class="card-title" {...post.edit.title}>{post.data.title}</h2>
							</a>
							{post.data.excerpt && <p class="card-excerpt" {...post.edit.excerpt}>{post.data.excerpt}</p>}
						</li>
					))}
				</ul>
			)
		}
		<nav class="mt-16 flex gap-3 font-mono text-sm empty:hidden" aria-label="Pagination">
			{cursor && <a class="pager-link" href={`/tag/${term.slug}`}>First page</a>}
			{
				nextCursor && (
					<a class="pager-link" href={`/tag/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`}>
						Next page
					</a>
				)
			}
		</nav>
	</div>
</Base>
