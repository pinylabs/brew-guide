---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText, WidgetArea } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

// SEO meta from content fields
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

// Taxonomy terms are already hydrated onto the entry by getEmDashEntry.
const tags = post.data.terms?.tag ?? [];
const categories = post.data.terms?.category ?? [];
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<div class="wrap entry-layout">
		<article class="max-w-entry">
			{
				post.data.featured_image && (
					<div class="mb-10 overflow-hidden rounded-photo bg-neutral-800 dark:bg-neutral-950 max-md:mb-7" {...post.edit.featured_image}>
						<Image class="block aspect-video h-auto w-full object-cover" image={post.data.featured_image} />
					</div>
				)
			}

			{
				categories.length > 0 && (
					<div class="chips mb-4.5">
						{categories.map((c) => (
							<a class="chip chip-category" href={`/category/${c.slug}`}>{c.label}</a>
						))}
					</div>
				)
			}

			<h1 class="entry-title" {...post.edit.title}>{post.data.title}</h1>

			{
				post.data.publishedAt && (
					<time class="mt-4.5 block font-mono text-xs text-neutral-400" datetime={post.data.publishedAt.toISOString()}>
						{post.data.publishedAt.toLocaleDateString("en-US", {
							year: "numeric",
							month: "long",
							day: "numeric",
						})}
					</time>
				)
			}

			<div class="prose">
				<PortableText value={post.data.content} />
			</div>

			{
				tags.length > 0 && (
					<div class="chips mt-12 border-t border-neutral-600 pt-7 dark:border-neutral-750">
						{tags.map((t) => (
							<a class="chip" href={`/tag/${t.slug}`}>{t.label}</a>
						))}
					</div>
				)
			}
		</article>

		<aside class="sidebar">
			<WidgetArea name="sidebar" />
		</aside>
	</div>
</Base>
