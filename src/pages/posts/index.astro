---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Single batched query for tags across every post, instead of calling
// getEntryTerms() per post (which would be N round-trips).
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);
const postsWithTags = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));
---

<Base title="All Posts">
	<section class="page-head wrap">
		<p class="eyebrow">Notes</p>
		<h1 class="page-title">Posts</h1>
	</section>

	<div class="wrap">
		{
			postsWithTags.length === 0 ? (
				<p class="text-xl text-neutral-400">No posts yet.</p>
			) : (
				<ul class="cards">
					{postsWithTags.map(({ post, tags }) => (
						<li>
							<a class="group block" href={`/posts/${post.id}`}>
								{post.data.featured_image && (
									<div class="card-photo" {...post.edit.featured_image}><Image class="photo-lean" image={post.data.featured_image} /></div>
								)}
								<h2 class="card-title" {...post.edit.title}>{post.data.title}</h2>
							</a>
							{post.data.excerpt && <p class="card-excerpt" {...post.edit.excerpt}>{post.data.excerpt}</p>}
							{tags.length > 0 && (
								<div class="chips mt-3.5">
									{tags.map((t) => (
										<a class="chip" href={`/tag/${t.slug}`}>{t.label}</a>
									))}
								</div>
							)}
						</li>
					))}
				</ul>
			)
		}
		<nav class="mt-16 flex gap-3 font-mono text-sm empty:hidden" aria-label="Pagination">
			{cursor && <a class="pager-link" href="/posts">First page</a>}
			{
				nextCursor && (
					<a class="pager-link" href={`/posts?cursor=${encodeURIComponent(nextCursor)}`}>
						Next page
					</a>
				)
			}
		</nav>
	</div>
</Base>
