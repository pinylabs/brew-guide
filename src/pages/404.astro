---
import Base from "../layouts/Base.astro";
---

<Base title="Not Found">
	<section class="wrap flex min-h-notfound flex-col justify-center py-18">
		<p class="eyebrow mt-6.5 mb-7.5 max-w-blurb text-lede">404</p>
		<h1 class="max-w-entry font-display text-hero max-md:text-hero-sm">Page <em class="text-primary-500 italic">not found.</em></h1>
		<p class="mt-6.5 mb-7.5 max-w-blurb text-lede text-neutral-400">The page you're looking for doesn't exist.</p>
		<div><a class="btn" href="/">Go home</a></div>
	</section>
</Base>
