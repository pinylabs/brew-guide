---
// The preview home, from its accepted design. The full template is being built by the Pinies;
// until then this page is the theme's home and the rest of the site is EmDash's own template.
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Brew Guide — better coffee at home</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..700,0..100,0..1;1,9..144,300..700,0..100,0..1&family=DM+Sans:opsz,wght@9..40,400..700&family=DM+Mono:wght@400;500&display=swap">
</head>
<body>
<header class="absolute inset-x-0 top-0 z-5"><div class="wrap flex h-20 items-center justify-between">
  <a class="font-wonk text-mark font-semibold whitespace-nowrap italic" href="/">brew<b class="font-semibold text-primary-500">/</b>guide</a>
  <nav class="flex items-center gap-7 text-base text-neutral-400"><a class="max-md:hidden" href="/guides">Methods</a><a class="max-md:hidden" href="/beans">Beans</a><a class="max-md:hidden" href="/how-we-test">How we test</a><span class="rounded-control border border-neutral-600 px-3 py-1.75 font-mono text-xs text-neutral-50 dark:border-neutral-750">⌘K search</span></nav>
</div></header>
<section class="hero-shade relative isolate h-220 overflow-hidden max-md:h-190">
  <video class="absolute inset-0 -z-2 size-full object-cover object-[70%_50%]" muted loop playsinline preload="none" poster="https://images.pexels.com/videos/30353740/olympus-30353740.jpeg?auto=compress&cs=tinysrgb&w=1600" data-src="https://videos.pexels.com/video-files/30353740/13010578_960_540_60fps.mp4" aria-label="Espresso pouring into a glass"></video>
  <div class="wrap flex h-full flex-col justify-center max-md:justify-end max-md:pb-14">
    <h1 class="max-w-headline font-display text-hero max-md:text-hero-sm"><span class="headline-word" style="--i:0">Better</span> <span class="headline-word" style="--i:1">coffee</span> <span class="headline-word" style="--i:2">at</span> <em class="headline-word text-primary-500 italic" style="--i:3">home.</em></h1>
    <p class="motion-fade mt-6.5 mb-7.5 max-w-blurb text-lede text-neutral-400 max-md:text-lg">One page for each way of brewing: the recipe, the steps with a timer, and what to change when it tastes wrong.</p>
    <div class="motion-fade mt-7.5 flex items-center gap-4.5"><svg class="size-28 flex-none" viewBox="0 0 112 112" aria-hidden="true"><circle class="stroke-neutral-50/15" cx="56" cy="56" r="48" fill="none" stroke-width="8"/><circle class="dial-ring stroke-primary-500" cx="56" cy="56" r="48" fill="none" stroke-width="8" stroke-linecap="round" transform="rotate(-90 56 56)"/><text class="fill-neutral-50" x="56" y="62" text-anchor="middle" font-family="DM Mono, monospace" font-size="17">1 : 16</text></svg><div><b class="block font-mono text-base font-medium text-neutral-400">15 g coffee · 250 g water</b><big class="font-display-straight text-stat">94 °C, 3:30</big></div></div>
  </div>
  <div class="absolute right-10 bottom-5 text-2xs text-neutral-400">Video: <a href="https://www.pexels.com/video/barista-crafting-fresh-espresso-shot-30353740/">Bobby Brown</a>, Pexels</div>
</section>
<section class="relative">
  <div class="pt-section pb-20 max-md:py-section-sm">
    <div class="wrap mb-7.5 flex items-end justify-between max-md:flex-col max-md:items-start max-md:gap-2"><h2 class="font-wonk text-section max-md:text-section-sm">Six ways <em class="text-primary-500">to brew</em></h2><p class="font-mono text-xs text-neutral-400">scroll sideways → each one is a recipe</p></div>
    <div class="rail-track" tabindex="0" role="region" aria-label="Six ways to brew">
      <a class="group w-method flex-none snap-start max-md:w-method-sm" href="/guides/pour-over"><div class="relative aspect-3/4 overflow-hidden rounded-photo"><img class="photo-lean" style="view-transition-name: guide-pourover" src="https://images.unsplash.com/photo-1759259639356-7c6e74eed1ec?w=1200&q=75&auto=format&fit=crop" alt="Hot water poured over coffee in a pour-over cone" loading="lazy"><span class="photo-tag">01 pour-over</span></div><h3 class="mt-3.5 font-serif text-card">Pour-over</h3><dl class="facts"><dt>ratio</dt><dt>grind</dt><dt>time</dt><dd>1:16</dd><dd>medium</dd><dd>3:30</dd></dl></a>
      <a class="group w-method flex-none snap-start max-md:w-method-sm" href="/guides/aeropress"><div class="relative aspect-3/4 overflow-hidden rounded-photo"><img class="photo-lean" src="https://images.unsplash.com/photo-1783351583601-f9a0fd43e658?w=1200&q=75&auto=format&fit=crop" alt="Hot water poured into an AeroPress" loading="lazy"><span class="photo-tag">02 aeropress</span></div><h3 class="mt-3.5 font-serif text-card">AeroPress</h3><dl class="facts"><dt>ratio</dt><dt>grind</dt><dt>time</dt><dd>1:15</dd><dd>fine</dd><dd>2:00</dd></dl></a>
      <a class="group w-method flex-none snap-start max-md:w-method-sm" href="/guides/french-press"><div class="relative aspect-3/4 overflow-hidden rounded-photo"><img class="photo-lean" src="https://images.unsplash.com/photo-1708127368781-cd5f069a90a5?w=1200&q=75&auto=format&fit=crop" alt="A French press on a wooden table" loading="lazy"><span class="photo-tag">03 french press</span></div><h3 class="mt-3.5 font-serif text-card">French press</h3><dl class="facts"><dt>ratio</dt><dt>grind</dt><dt>time</dt><dd>1:15</dd><dd>coarse</dd><dd>4:00</dd></dl></a>
      <a class="group w-method flex-none snap-start max-md:w-method-sm" href="/guides/moka-pot"><div class="relative aspect-3/4 overflow-hidden rounded-photo"><img class="photo-lean" src="https://images.unsplash.com/photo-1781574120734-c3fceee09415?w=1200&q=75&auto=format&fit=crop" alt="A moka pot brewing on a stove" loading="lazy"><span class="photo-tag">04 moka pot</span></div><h3 class="mt-3.5 font-serif text-card">Moka pot</h3><dl class="facts"><dt>water</dt><dt>grind</dt><dt>time</dt><dd>to valve</dd><dd>fine</dd><dd>5:00</dd></dl></a>
      <a class="group w-method flex-none snap-start max-md:w-method-sm" href="/guides/espresso"><div class="relative aspect-3/4 overflow-hidden rounded-photo"><img class="photo-lean" src="https://images.unsplash.com/photo-1573761877924-7babc31ca392?w=1200&q=75&auto=format&fit=crop" alt="Tamping ground coffee into a portafilter" loading="lazy"><span class="photo-tag">05 espresso</span></div><h3 class="mt-3.5 font-serif text-card">Espresso</h3><dl class="facts"><dt>in</dt><dt>out</dt><dt>time</dt><dd>18 g</dd><dd>36 g</dd><dd>0:28</dd></dl></a>
      <a class="group w-method flex-none snap-start max-md:w-method-sm" href="/guides/cold-brew"><div class="relative aspect-3/4 overflow-hidden rounded-photo"><img class="photo-lean" src="https://images.unsplash.com/photo-1759259639356-6eee63241869?w=1200&q=75&auto=format&fit=crop" alt="Cold brew over ice in a mason jar" loading="lazy"><span class="photo-tag">06 cold brew</span></div><h3 class="mt-3.5 font-serif text-card">Cold brew</h3><dl class="facts"><dt>ratio</dt><dt>grind</dt><dt>time</dt><dd>1:8</dd><dd>coarse</dd><dd>16 h</dd></dl></a>
    </div>
  </div>
</section>
<section class="border-t border-neutral-600 py-section dark:border-neutral-750 max-md:py-section-sm"><div class="wrap grid grid-cols-2 items-center gap-16 max-md:grid-cols-1 max-md:gap-7">
  <div class="motion-fade"><h2 class="font-wonk text-feature max-md:text-feature-sm">How we test a recipe</h2><p class="mt-4.5 text-xl leading-reading text-neutral-400">Every recipe is brewed at home by a person, three times, before it is published. We write down the beans, the grinder and what we changed, and the page says when it was last brewed.</p></div>
  <div class="motion-fade panel px-6 py-5.5 font-mono text-sm"><div class="sheet-row"><span>recipe</span><span>pour-over, 15 g : 250 g</span></div><div class="sheet-row"><span>beans</span><span>the roaster and roast date go here</span></div><div class="sheet-row"><span>brewed</span><span>3 times, by a person</span></div><div class="sheet-row"><span>changed</span><span>grind one step finer</span></div><div class="sheet-row"><span>result</span><span class="text-tertiary-300">published</span></div></div>
</div></section>
<section class="beans-shade relative isolate grid h-130 place-items-center overflow-hidden"><img class="motion-drift absolute inset-0 -z-2 size-full object-cover opacity-55" src="https://images.unsplash.com/photo-1587734195342-39d4b9b2ff05?w=1600&q=75&auto=format&fit=crop" alt="Roasted coffee beans in a white bowl" loading="lazy"><blockquote class="motion-fade max-w-quote px-6 text-center font-wonk text-quote italic max-md:text-quote-sm">“Weigh your coffee. It changes more than any machine.”<small class="mt-4.5 block font-mono text-xs text-neutral-400 not-italic">Start here: beans, grind and water · Photo: <a href="https://unsplash.com/photos/brown-coffee-beans-in-white-ceramic-bowl-fHZYP7QR8NI">Alin Luna</a></small></blockquote></section>
<SiteFooter entrance />
<script is:inline>
// The Pinies' entrance: when a row of them comes into view, they play the next of the public site's four, in order,
// remembered in this browser, never random. Reduced motion, no storage or no script: the Pinies simply stand there.
(() => {
  const order = ['walk', 'skid', 'drop', 'peek'];
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches || document.documentElement.classList.contains('still');
  for (const row of document.querySelectorAll('.pinies[data-entrance-row]')) {
    row.querySelectorAll('.face').forEach((face, i) => face.style.setProperty('--i', String(i)));
    if (still || !('IntersectionObserver' in window)) { row.dataset.shown = ''; continue; }
    const seen = new IntersectionObserver(entries => {
      if (!entries.some(entry => entry.isIntersecting)) return;
      seen.disconnect();
      let next = 0;
      try { next = (Number(localStorage.getItem('tm06-entrance-next')) || 0) % order.length; localStorage.setItem('tm06-entrance-next', String(next + 1)); } catch {}
      row.dataset.entrance = row.dataset.play || order[next];
      setTimeout(() => { row.dataset.shown = ''; delete row.dataset.entrance; }, 2600);
    }, { threshold: 0.6 });
    seen.observe(row);
  }
})();

// A hero's loop: the poster shows first; the clip loads and plays only with motion allowed and the page visible.
(() => {
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches || document.documentElement.classList.contains('still');
  for (const video of document.querySelectorAll('video[data-src]')) {
    if (still) continue;
    video.src = video.dataset.src;
    video.play().catch(() => {});
  }
})();
</script>
</body>
</html>
