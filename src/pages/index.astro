---
// The preview home, from its accepted design. The full template is being built by the Pinies;
// until then this page is the theme's home and the rest of the site is EmDash's own template.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Brew Guide — better coffee at home</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..700,0..100,0..1;1,9..144,300..700,0..100,0..1&family=DM+Sans:opsz,wght@9..40,400..700&family=DM+Mono:wght@400;500&display=swap">
<style is:global>
/* The motion every site shares. Only transform and opacity move, so it stays on the compositor at 60 fps. Under
   prefers-reduced-motion everything is still, and a browser without scroll timelines simply shows the page. */

/* Page changes: the browser's cross-document view transition, as Astro's view transitions give it. A picture that
   names itself the same on both pages grows into its place; the rest fades and slides. */
@view-transition { navigation: auto; }
::view-transition-old(root) { animation: 260ms cubic-bezier(.4, 0, 1, 1) both vt-out; }
::view-transition-new(root) { animation: 420ms cubic-bezier(0, 0, .2, 1) 80ms both vt-in; }
::view-transition-group(*) { animation-duration: 520ms; animation-timing-function: cubic-bezier(.2, .8, .2, 1); }
@keyframes vt-out { to { opacity: 0; transform: translateY(-12px); } }
@keyframes vt-in { from { opacity: 0; transform: translateY(24px); } }

/* The hero's first moment: its words rise one line after another. */
.rise { animation: rise .9s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--i, 0) * 110ms + 120ms); }
@keyframes rise { from { opacity: 0; transform: translateY(36px); } }

/* Scroll-driven: reveals move with `translate` and `scale`, so a card's hover `transform` still applies.
   The hero's photo drifts slower than the page, and its words lift away. */
@supports (animation-timeline: scroll()) {
  .parallax { animation: parallax linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
  .lift { animation: lift linear both; animation-timeline: scroll(root); animation-range: 0 70vh; }
  .reveal { animation: reveal linear both; animation-timeline: view(); animation-range: entry 0% entry 70%; }
  .reveal-side { animation: reveal-side linear both; animation-timeline: view(); animation-range: entry 0% entry 80%; }
  .zoom-in { animation: zoom-in linear both; animation-timeline: view(); animation-range: entry 0% cover 50%; }
}
@keyframes parallax { from { transform: translateY(0) scale(1.08); } to { transform: translateY(22%) scale(1.16); } }
@keyframes lift { to { opacity: 0; transform: translateY(-90px); } }
@keyframes reveal { from { opacity: 0; translate: 0 70px; scale: .97; } }
@keyframes reveal-side { from { opacity: 0; translate: -60px 0; } }
@keyframes zoom-in { from { transform: scale(1.25); } }

/* Hover, for a site that takes it: a card lifts and its photo leans in. Each site adds its own signature beside it. */
.lift-card { transition: transform .45s cubic-bezier(.2, .8, .2, 1), box-shadow .45s; }
.lift-card .pic img { transition: transform .9s cubic-bezier(.2, .8, .2, 1); }
.lift-card:hover { transform: translateY(-8px); }
.lift-card:hover .pic img { transform: scale(1.07); }
.button { transition: transform .25s cubic-bezier(.2, .8, .2, 1), background-color .25s; }
.button:hover { transform: translateY(-2px); }

/* Calm: opacity only, for a site whose signature is stillness. */
@supports (animation-timeline: view()) {
  .fade { animation: fade linear both; animation-timeline: view(); animation-range: entry 0% entry 90%; }
}
@keyframes fade { from { opacity: 0; } }

/* The Pinies' entrances, the public site's four, played once when their row comes into view. */
.pinies[data-entrance] .face { animation-duration: .9s; animation-fill-mode: both; animation-delay: calc(var(--i) * .14s); animation-timing-function: cubic-bezier(.3, .7, .3, 1); }
.pinies[data-entrance='walk'] .face { animation-name: walk; }
.pinies[data-entrance='skid'] .face { animation-name: skid; }
.pinies[data-entrance='drop'] .face { animation-name: drop; animation-timing-function: ease-in; }
.pinies[data-entrance='peek'] .face { animation-name: peek; }
.pinies[data-entrance='peek'] .face:last-child { animation-name: peek, wave; animation-duration: .9s, .6s; animation-delay: calc(4 * .14s), 1.5s; animation-fill-mode: both, none; }
.pinies:not([data-entrance]):not([data-shown]) .face { opacity: 0; }
@keyframes walk {
  0% { transform: translateX(-120px); opacity: 0; } 12% { opacity: 1; }
  20% { transform: translateX(-96px) translateY(-4px); } 35% { transform: translateX(-70px) translateY(0); }
  50% { transform: translateX(-44px) translateY(-4px); } 65% { transform: translateX(-16px) translateY(0); }
  80% { transform: translateX(0) translateY(-16px); } 100% { transform: translateX(0) translateY(0); }
}
@keyframes skid {
  0% { transform: translateX(520px) rotate(0); opacity: 0; } 15% { opacity: 1; }
  65% { transform: translateX(-8px) rotate(-12deg); } 82% { transform: translateX(3px) rotate(3deg); } 100% { transform: translateX(0) rotate(0); }
}
@keyframes drop {
  0% { transform: translateY(-120px); opacity: 0; } 15% { opacity: 1; }
  60% { transform: translateY(0); } 75% { transform: translateY(-12px); } 90% { transform: translateY(0); } 95% { transform: translateY(-3px); } 100% { transform: translateY(0); }
}
@keyframes peek { 0% { transform: translateY(56px); opacity: 0; } 20% { opacity: 1; } 70% { transform: translateY(-5px); } 100% { transform: translateY(0); } }
@keyframes wave { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(-12deg); } 50% { transform: rotate(10deg); } 75% { transform: rotate(-6deg); } }

/* Still: reduced motion, and the stills this mock renders. */
@media (prefers-reduced-motion: reduce) {
  @view-transition { navigation: none; }
  *, *::before, *::after { animation: none !important; transition: none !important; }
  .pinies .face { opacity: 1 !important; }
}
html.still *, html.still *::before, html.still *::after { animation: none !important; transition: none !important; }
html.still .pinies .face { opacity: 1 !important; }
</style>
<style is:global>
/* Dark-led by design: the same espresso night in either scheme, with a lighter roast for a light preference. */
:root {
  --ground: #0d0907; --ink: #f3e8da; --soft: #b9a593; --crema: #e88a3c; --foam: #f6d9b5; --card: #18110d; --line: #2c211a; --chip: #e88a3c; --chip-ink: #1a0e06;
  --display: 'Fraunces', Georgia, serif; --sans: 'DM Sans', system-ui, sans-serif; --mono: 'DM Mono', ui-monospace, monospace;
}
@media (prefers-color-scheme: light) { :root { --ground: #1b130e; --card: #241912; --line: #3a2b21; } }
* { box-sizing: border-box; margin: 0; }
html { background: var(--ground); }
body { background: var(--ground); color: var(--ink); font-family: var(--sans); -webkit-font-smoothing: antialiased; overflow-x: clip; }
a { color: inherit; text-decoration: none; }
.wrap { max-width: 1280px; margin: 0 auto; padding: 0 40px; }
header { position: absolute; inset: 0 0 auto; z-index: 5; }
header .wrap { display: flex; align-items: center; justify-content: space-between; height: 80px; }
.mark { font-family: var(--display); font-style: italic; font-weight: 600; font-size: 30px; letter-spacing: -.02em; font-variation-settings: 'SOFT' 100, 'WONK' 1; }
.mark b { color: var(--crema); font-weight: 600; }
nav { display: flex; gap: 28px; font-size: 15px; align-items: center; color: var(--soft); }
nav .mono { font-family: var(--mono); font-size: 13px; border: 1px solid var(--line); padding: 7px 12px; border-radius: 8px; color: var(--ink); }
.hero { position: relative; height: 880px; overflow: hidden; isolation: isolate; }
.hero video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 70% 50%; z-index: -2; }
/* The signature: the headline sets word by word, each word settling from a light weight to its own; the dial fills to 1 : 16. */
.hero h1 .w { display: inline-block; opacity: 0; animation: set .9s cubic-bezier(.2, .7, .2, 1) both; animation-delay: calc(var(--i) * 140ms + 250ms); }
@keyframes set { 0% { opacity: 0; transform: translateY(.18em); font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144, 'wght' 200; } 100% { opacity: 1; transform: none; font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144, 'wght' 400; } }
.dial { display: flex; align-items: center; gap: 18px; margin-top: 30px; }
.dial svg { width: 112px; height: 112px; flex: none; }
.dial .ring { stroke-dasharray: 302; stroke-dashoffset: 302; animation: fill 2.2s cubic-bezier(.4, 0, .2, 1) 1s both; }
@keyframes fill { to { stroke-dashoffset: 18; } }
.dial b { font-family: var(--mono); font-weight: 500; font-size: 15px; color: var(--soft); display: block; }
.dial big { font-family: var(--display); font-size: 44px; line-height: 1; font-variation-settings: 'SOFT' 100, 'opsz' 144; }
html.still .hero h1 .w { opacity: 1; } html.still .dial .ring { stroke-dashoffset: 18; }
@media (prefers-reduced-motion: reduce) { .hero h1 .w { opacity: 1; } .dial .ring { stroke-dashoffset: 18; } }
.hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(13, 9, 7, .94) 0%, rgba(13, 9, 7, .7) 38%, rgba(13, 9, 7, 0) 70%), linear-gradient(0deg, var(--ground) 0%, rgba(13, 9, 7, 0) 30%); }
.hero .wrap { height: 100%; display: flex; flex-direction: column; justify-content: center; }
.hero h1 { font-family: var(--display); font-weight: 400; font-size: 132px; line-height: .88; letter-spacing: -.04em; max-width: 700px; font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144; }
.hero h1 em { font-style: italic; color: var(--crema); }
.hero p { font-size: 19px; line-height: 1.55; color: var(--soft); max-width: 440px; margin: 26px 0 30px; }
.ticker { display: flex; gap: 10px; flex-wrap: wrap; font-family: var(--mono); font-size: 15px; }
.ticker span { border: 1px solid rgba(243, 232, 218, .25); border-radius: 8px; padding: 8px 12px; backdrop-filter: blur(6px); }
.ticker span b { color: var(--crema); font-weight: 500; }
.hero .credit { position: absolute; right: 40px; bottom: 20px; font-size: 12px; color: var(--soft); }
@supports (animation-timeline: scroll()) {
  .slow { animation: slow linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
}
@keyframes slow { from { transform: scale(1.04); } to { transform: scale(1.14) translateY(4%); } }
/* The signature: the methods pin, and the page's scroll moves them sideways. */
.rail { position: relative; height: 300vh; view-timeline-name: --rail; }
.rail .pin { position: sticky; top: 0; height: 100vh; overflow: hidden; display: flex; flex-direction: column; justify-content: center; }
.rail .head { display: flex; justify-content: space-between; align-items: end; margin-bottom: 30px; }
.rail h2 { font-family: var(--display); font-weight: 400; font-size: 84px; letter-spacing: -.04em; line-height: .9; font-variation-settings: 'SOFT' 100, 'WONK' 1; }
.rail h2 em { color: var(--crema); }
.rail .head p { font-family: var(--mono); font-size: 13px; color: var(--soft); }
.track { display: flex; gap: 22px; padding-left: max(40px, calc((100vw - 1200px) / 2)); width: max-content; }
@supports (animation-timeline: view()) {
  .track { animation: slide linear both; animation-timeline: --rail; animation-range: contain 0% contain 100%; }
}
@keyframes slide { to { transform: translateX(calc(-100% + 100vw)); } }
.method { width: 360px; flex: none; }
.method .pic { position: relative; aspect-ratio: 3 / 4; border-radius: 6px; overflow: hidden; }
.method .pic img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s cubic-bezier(.2, .8, .2, 1), filter .8s; filter: saturate(.9); }
.method:hover .pic img { transform: scale(1.04); filter: saturate(1.15); }
.method .tag { position: absolute; left: 0; bottom: 0; background: var(--chip); color: var(--chip-ink); font-family: var(--mono); font-size: 13px; padding: 6px 10px; text-transform: uppercase; }
.method h3 { font-family: var(--display); font-weight: 400; font-size: 40px; letter-spacing: -.03em; margin-top: 14px; }
.method dl { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 2px 22px; font-family: var(--mono); font-size: 13px; color: var(--soft); margin-top: 6px; }
.method dd { color: var(--ink); margin: 0; font-size: 15px; }
.test { border-top: 1px solid var(--line); padding: 96px 0; }
.test .wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
.test h2 { font-family: var(--display); font-weight: 400; font-size: 64px; letter-spacing: -.035em; line-height: .95; font-variation-settings: 'SOFT' 100, 'WONK' 1; }
.test p { color: var(--soft); font-size: 18px; line-height: 1.6; margin-top: 18px; }
.sheet { font-family: var(--mono); font-size: 14px; background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 22px 24px; }
.sheet .row { display: grid; grid-template-columns: 130px 1fr; padding: 10px 0; border-bottom: 1px dashed var(--line); }
.sheet .row:last-child { border: 0; }
.sheet .row span:first-child { color: var(--soft); }
.sheet .ok { color: #8fd19e; }
.beans { position: relative; height: 520px; overflow: hidden; display: grid; place-items: center; isolation: isolate; }
.beans img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; opacity: .55; }
.beans::after { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(circle at center, rgba(13, 9, 7, .2), var(--ground) 75%); }
.beans blockquote { font-family: var(--display); font-style: italic; font-size: 52px; line-height: 1.1; text-align: center; max-width: 820px; padding: 0 24px; font-variation-settings: 'SOFT' 100, 'WONK' 1; }
.beans small { display: block; font-family: var(--mono); font-style: normal; font-size: 13px; color: var(--soft); margin-top: 18px; }
footer { border-top: 1px solid var(--line); padding: 40px 0 48px; }
footer .wrap { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: end; }
footer .made { display: flex; align-items: flex-end; gap: 18px; }
.pinies { display: flex; }
.pinies .face { width: 56px; height: 56px; margin-right: -8px; }
.pinies .face svg { width: 100%; height: 100%; }
footer .made p { font-size: 16px; line-height: 1.5; color: var(--soft); }
footer .made a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
footer .credits { font-family: var(--mono); font-size: 12px; line-height: 1.8; color: var(--soft); }
footer .credits a { text-decoration: underline; text-decoration-color: var(--line); }
@media (max-width: 767px) {
  .wrap { padding: 0 18px; }
  nav a { display: none; }
  .hero { height: 760px; }
  .hero::after { background: linear-gradient(0deg, var(--ground) 10%, rgba(13, 9, 7, .55) 55%, rgba(13, 9, 7, .2)); }
  .hero .wrap { justify-content: flex-end; padding-bottom: 56px; }
  .hero h1 { font-size: 68px; }
  .hero p { font-size: 17px; }
  .rail { height: auto; }
  .rail .pin { position: static; height: auto; padding: 56px 0; }
  .rail h2 { font-size: 52px; }
  .rail .head { padding: 0 18px; flex-direction: column; align-items: start; gap: 8px; }
  .track { animation: none; overflow-x: auto; width: auto; padding: 0 18px 8px; scroll-snap-type: x mandatory; }
  .method { width: 78vw; scroll-snap-align: start; }
  .test { padding: 56px 0; }
  .test .wrap { grid-template-columns: 1fr; gap: 28px; }
  .test h2 { font-size: 44px; }
  .beans blockquote { font-size: 32px; }
  footer .wrap { grid-template-columns: 1fr; }
  footer .made { flex-direction: column; align-items: flex-start; }
}
.still-card { height: 100%; display: grid; place-items: center; background: linear-gradient(135deg, var(--sky1, #bfe8ef), var(--sky2, #ffe2b8)); font-family: var(--display); font-weight: 700; font-size: 34px; color: var(--ink); }
</style>
</head>
<body>
<header><div class="wrap">
  <a class="mark" href="/">brew<b>/</b>guide</a>
  <nav><a href="/guides">Methods</a><a href="/beans">Beans</a><a href="/how-we-test">How we test</a><span class="mono">⌘K search</span></nav>
</div></header>
<section class="hero">
  <video muted loop playsinline preload="none" poster="https://images.pexels.com/videos/30353740/olympus-30353740.jpeg?auto=compress&cs=tinysrgb&w=1600" data-src="https://videos.pexels.com/video-files/30353740/13010578_960_540_60fps.mp4" aria-label="Espresso pouring into a glass"></video>
  <div class="wrap">
    <h1><span class="w" style="--i:0">Better</span> <span class="w" style="--i:1">coffee</span> <span class="w" style="--i:2">at</span> <em class="w" style="--i:3">home.</em></h1>
    <p class="fade">One page for each way of brewing: the recipe, the steps with a timer, and what to change when it tastes wrong.</p>
    <div class="dial fade"><svg viewBox="0 0 112 112" aria-hidden="true"><circle cx="56" cy="56" r="48" fill="none" stroke="rgba(243, 232, 218, .15)" stroke-width="8"/><circle class="ring" cx="56" cy="56" r="48" fill="none" stroke="var(--crema)" stroke-width="8" stroke-linecap="round" transform="rotate(-90 56 56)"/><text x="56" y="62" text-anchor="middle" font-family="DM Mono, monospace" font-size="17" fill="var(--ink)">1 : 16</text></svg><div><b>15 g coffee · 250 g water</b><big>94 °C, 3:30</big></div></div>
  </div>
  <div class="credit">Video: <a href="https://www.pexels.com/video/barista-crafting-fresh-espresso-shot-30353740/">Bobby Brown</a>, Pexels</div>
</section>
<section class="rail">
  <div class="pin">
    <div class="head wrap"><h2>Six ways <em>to brew</em></h2><p>scroll → each one is a recipe</p></div>
    <div class="track">
      <a class="method" href="/guides/pour-over"><div class="pic"><img style="view-transition-name: guide-pourover" src="https://images.unsplash.com/photo-1759259639356-7c6e74eed1ec?w=1200&q=75&auto=format&fit=crop" alt="Hot water poured over coffee in a pour-over cone" loading="lazy"><span class="tag">01 pour-over</span></div><h3>Pour-over</h3><dl><dt>ratio</dt><dt>grind</dt><dt>time</dt><dd>1:16</dd><dd>medium</dd><dd>3:30</dd></dl></a>
      <a class="method" href="/guides/aeropress"><div class="pic"><img src="https://images.unsplash.com/photo-1783351583601-f9a0fd43e658?w=1200&q=75&auto=format&fit=crop" alt="Hot water poured into an AeroPress" loading="lazy"><span class="tag">02 aeropress</span></div><h3>AeroPress</h3><dl><dt>ratio</dt><dt>grind</dt><dt>time</dt><dd>1:15</dd><dd>fine</dd><dd>2:00</dd></dl></a>
      <a class="method" href="/guides/french-press"><div class="pic"><img src="https://images.unsplash.com/photo-1708127368781-cd5f069a90a5?w=1200&q=75&auto=format&fit=crop" alt="A French press on a wooden table" loading="lazy"><span class="tag">03 french press</span></div><h3>French press</h3><dl><dt>ratio</dt><dt>grind</dt><dt>time</dt><dd>1:15</dd><dd>coarse</dd><dd>4:00</dd></dl></a>
      <a class="method" href="/guides/moka-pot"><div class="pic"><img src="https://images.unsplash.com/photo-1781574120734-c3fceee09415?w=1200&q=75&auto=format&fit=crop" alt="A moka pot brewing on a stove" loading="lazy"><span class="tag">04 moka pot</span></div><h3>Moka pot</h3><dl><dt>water</dt><dt>grind</dt><dt>time</dt><dd>to valve</dd><dd>fine</dd><dd>5:00</dd></dl></a>
      <a class="method" href="/guides/espresso"><div class="pic"><img src="https://images.unsplash.com/photo-1573761877924-7babc31ca392?w=1200&q=75&auto=format&fit=crop" alt="Tamping ground coffee into a portafilter" loading="lazy"><span class="tag">05 espresso</span></div><h3>Espresso</h3><dl><dt>in</dt><dt>out</dt><dt>time</dt><dd>18 g</dd><dd>36 g</dd><dd>0:28</dd></dl></a>
      <a class="method" href="/guides/cold-brew"><div class="pic"><img src="https://images.unsplash.com/photo-1759259639356-6eee63241869?w=1200&q=75&auto=format&fit=crop" alt="Cold brew over ice in a mason jar" loading="lazy"><span class="tag">06 cold brew</span></div><h3>Cold brew</h3><dl><dt>ratio</dt><dt>grind</dt><dt>time</dt><dd>1:8</dd><dd>coarse</dd><dd>16 h</dd></dl></a>
    </div>
  </div>
</section>
<section class="test"><div class="wrap">
  <div class="fade"><h2>How we test a recipe</h2><p>Every recipe is brewed at home by a person, three times, before it is published. We write down the beans, the grinder and what we changed, and the page says when it was last brewed.</p></div>
  <div class="sheet fade"><div class="row"><span>recipe</span><span>pour-over, 15 g : 250 g</span></div><div class="row"><span>beans</span><span>the roaster and roast date go here</span></div><div class="row"><span>brewed</span><span>3 times, by a person</span></div><div class="row"><span>changed</span><span>grind one step finer</span></div><div class="row"><span>result</span><span class="ok">published</span></div></div>
</div></section>
